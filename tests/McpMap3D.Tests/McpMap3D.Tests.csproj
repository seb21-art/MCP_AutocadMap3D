<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <!-- Géométrie pure du plug-in, sans dépendance à AutoCAD. -->
    <Compile Include="..\..\src\McpMap3D.Plugin\Geometry\*.cs" Link="Geometry\%(Filename)%(Extension)" />
    <!-- Allègement des schémas d'outils du serveur, sans dépendance au SDK MCP. -->
    <Compile Include="..\..\src\McpMap3D.Server\ToolSchemaCompactor.cs" Link="Server\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
